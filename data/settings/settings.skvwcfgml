# data driven settings
[audio]
sound effects: true
- music volume: 0.05
# min [0]
# Low [0.2]
# default [0.4]
# High [0.7]
# max [1]
music: false
loop music: false
[popups]
popups: true
chat popups: true
[chat]
censoring: true
hide GIFs: false
disable rank effects: false
[cloak]
enabled: false
+cloak:
# managebac
# drive
# portal
[tips]
enabled: true
-delay: 1000
# min [4000]
# default [15000]
# max [40000]
[number pillars]
music: false
confetti: true
large popups: false
